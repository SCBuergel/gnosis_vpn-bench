{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SCBuergel/gnosis_vpn-bench/schema/result.schema.json",
  "title": "gnosis_vpn-bench result",
  "description": "One benchmark run. See docs/result-schema.md. Missing measurements are null, never 0.",
  "type": "object",
  "required": [
    "schema_version",
    "run",
    "provenance",
    "concurrent",
    "per_client",
    "availability",
    "failures"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "ladder",
            "sweep",
            "local"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reproducible": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "experiment": {
          "type": "object",
          "required": [
            "id",
            "cycle",
            "cycles",
            "position",
            "targets"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "cycle": {
              "type": "integer",
              "minimum": 1
            },
            "cycles": {
              "type": "integer",
              "minimum": 1
            },
            "position": {
              "type": "integer",
              "minimum": 1
            },
            "targets": {
              "type": "integer",
              "minimum": 1
            }
          },
          "description": "Optional schedule identity; cycle <= cycles and position <= targets are checked by the runtime validator."
        },
        "historical_source": {
          "type": [
            "string",
            "null"
          ],
          "description": "Set when imported from an older tool."
        }
      },
      "required": [
        "id",
        "kind",
        "created_at",
        "started_at",
        "finished_at",
        "reproducible",
        "notes"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "bench": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string"
            },
            "commit": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "version",
            "commit"
          ]
        },
        "profile": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "network": {
              "type": "string"
            },
            "channel": {
              "type": [
                "string",
                "null"
              ]
            },
            "package_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "package_sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "worker_model": {
              "enum": [
                "v4-root",
                "v5-user",
                "local"
              ]
            }
          },
          "required": [
            "name",
            "network",
            "channel",
            "package_version",
            "package_sha256",
            "worker_model"
          ]
        },
        "client": {
          "type": "object",
          "properties": {
            "ctl_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "package_version": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "ctl_version",
            "package_version"
          ]
        },
        "target": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "exit_address": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "network": {
              "type": "string"
            },
            "location": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "label",
            "exit_address",
            "network",
            "location"
          ]
        },
        "infrastructure": {
          "type": "object",
          "properties": {
            "provider": {
              "enum": [
                "digitalocean",
                "local",
                "other"
              ]
            },
            "region": {
              "type": [
                "string",
                "null"
              ]
            },
            "machines": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "size": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "vcpus": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "memory_mib": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "cpu_model": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "os": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "architecture": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "cpu_vendor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "cpu_sockets": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "cores_per_socket": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "threads_per_core": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "hypervisor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "root_disk_gib": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "root_free_gib": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "swap_mib": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "package_version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "ctl_version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "kernel": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "role",
                  "name",
                  "size",
                  "vcpus",
                  "memory_mib",
                  "cpu_model",
                  "os",
                  "kernel"
                ]
              }
            }
          },
          "required": [
            "provider",
            "region",
            "machines"
          ]
        },
        "client_config_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "bench",
        "profile",
        "client",
        "target",
        "infrastructure"
      ]
    },
    "concurrent": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "spec": {
              "type": "object",
              "properties": {
                "transfer_bytes": {
                  "type": "integer"
                },
                "deadline_s": {
                  "type": "number"
                },
                "gap_s": {
                  "type": "number"
                },
                "ping_target": {
                  "type": "string"
                },
                "ping_interval_s": {
                  "type": "number"
                }
              },
              "required": [
                "transfer_bytes",
                "deadline_s",
                "gap_s",
                "ping_target",
                "ping_interval_s"
              ]
            },
            "origin": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "bytes": {
                  "type": "integer"
                },
                "sha256": {
                  "type": "string"
                }
              }
            },
            "baseline": {
              "type": "array",
              "description": "Direct (non-VPN) downloads from the origin; an origin-capacity check, not a VPN result.",
              "items": {
                "type": "object",
                "properties": {
                  "client": {
                    "type": "string"
                  },
                  "mbps": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "bytes": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "required": [
                  "client",
                  "mbps",
                  "bytes"
                ]
              }
            },
            "rungs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/rung"
              }
            },
            "idle_ping": {
              "type": "array",
              "description": "Unloaded ping through each client's tunnel before rung 1, all clients at once (30 pings, 1 s apart).",
              "items": {
                "type": "object",
                "properties": {
                  "client": {
                    "type": "string"
                  },
                  "sent": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "received": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "loss_pct": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "min_ms": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "mean_ms": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "max_ms": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "status": {
                    "enum": [
                      "measured",
                      "no_reply"
                    ]
                  }
                },
                "required": [
                  "client",
                  "sent",
                  "received",
                  "loss_pct",
                  "min_ms",
                  "mean_ms",
                  "max_ms",
                  "status"
                ]
              }
            }
          },
          "required": [
            "spec",
            "rungs"
          ]
        }
      ]
    },
    "per_client": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "client": {
            "type": "string"
          },
          "connected": {
            "type": "boolean"
          },
          "connect_time_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "exit_address": {
            "type": [
              "string",
              "null"
            ]
          },
          "egress_changed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "measurements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "download",
                    "upload",
                    "latency"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "size_bytes": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "mbps": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "ms": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                }
              },
              "required": [
                "kind",
                "label",
                "mbps",
                "ms"
              ]
            }
          }
        },
        "required": [
          "client",
          "connected",
          "connect_time_s"
        ]
      }
    },
    "availability": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "exit_address": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{40}$"
          },
          "exit_label": {
            "type": "string"
          },
          "exit_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "client": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "download_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "download_mbps": {
            "type": [
              "number",
              "null"
            ]
          },
          "ping_mean_ms": {
            "type": [
              "number",
              "null"
            ]
          },
          "ping_loss_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "api_rtt_ms": {
            "type": [
              "number",
              "null"
            ]
          },
          "tested_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "exit_address",
          "exit_label",
          "client",
          "status",
          "detail",
          "download_mbps",
          "ping_mean_ms",
          "ping_loss_pct",
          "api_rtt_ms"
        ]
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "enum": [
              "run",
              "rung",
              "client",
              "exit"
            ]
          },
          "subject": {
            "type": "string"
          },
          "status": {
            "enum": [
              "UnacceptablePixParams",
              "DestinationNotFound",
              "http_404_register",
              "timeout",
              "control_timeout",
              "worker_not_ready",
              "connect_rejected",
              "route_bypass",
              "download_incomplete",
              "no_overlap",
              "not_run",
              "error"
            ]
          },
          "detail": {
            "type": "string"
          },
          "at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "scope",
          "subject",
          "status",
          "detail",
          "at"
        ]
      }
    },
    "payment": {
      "type": [
        "object",
        "null"
      ],
      "description": "Added after recovery: wxHOPR funded, returned and spent (decimal strings).",
      "properties": {
        "funded_wxHOPR": {
          "type": "string"
        },
        "recovered_wxHOPR": {
          "type": "string"
        },
        "spent_wxHOPR": {
          "type": "string"
        },
        "pix": {
          "type": "boolean"
        },
        "transferred_bytes": {
          "type": "integer"
        }
      },
      "required": [
        "funded_wxHOPR",
        "recovered_wxHOPR",
        "spent_wxHOPR",
        "pix"
      ]
    },
    "warnings": {
      "type": "array",
      "description": "Problems a reader must see first, e.g. pix_no_payment.",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail"
        ]
      }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "connected",
        "UnacceptablePixParams",
        "DestinationNotFound",
        "http_404_register",
        "timeout",
        "control_timeout",
        "worker_not_ready",
        "connect_rejected",
        "route_bypass",
        "download_incomplete",
        "no_overlap",
        "not_run",
        "error"
      ],
      "description": "Fixed outcome list. 'connected' is the only success value."
    },
    "rung": {
      "type": "object",
      "properties": {
        "rung": {
          "type": "integer"
        },
        "clients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "measured",
            "failed",
            "not_run"
          ]
        },
        "failure_status": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/status"
            }
          ]
        },
        "total_mbps": {
          "type": [
            "number",
            "null"
          ]
        },
        "overlap_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "start_skew_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "gap_before_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "overlap_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "overlap_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "per_client": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "client": {
                "type": "string"
              },
              "mbps": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "overlap_bytes": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "downloaded_bytes": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "complete": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "sha256_verified": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "timed_out": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "ping_mean_ms": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "ping_loss_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "ping_sent": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "ping_received": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "timeseries": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Per-second samples since the rung's scheduled start.",
                "properties": {
                  "t_s": {
                    "type": "array"
                  },
                  "mbps": {
                    "type": "array"
                  },
                  "rtt_ms": {
                    "type": "array"
                  },
                  "cpu_pct": {
                    "type": "array",
                    "description": "Optional; per second, when host samples exist."
                  },
                  "mem_available_mib": {
                    "type": "array",
                    "description": "Optional; per second, when host samples exist."
                  },
                  "load1": {
                    "type": "array",
                    "description": "Optional; per second, when host samples exist."
                  }
                }
              },
              "system": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Client host load during its transfer; null with fewer than 2 samples.",
                "properties": {
                  "cpu_mean_pct": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "cpu_max_pct": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "mem_available_min_mib": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "load1_max": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            },
            "required": [
              "client",
              "mbps",
              "overlap_bytes",
              "downloaded_bytes",
              "complete",
              "sha256_verified",
              "timed_out",
              "ping_mean_ms",
              "ping_loss_pct"
            ]
          }
        },
        "detail": {
          "type": "string",
          "description": "Why an unmeasured rung has no data (optional)."
        },
        "connection_check": {
          "type": "object",
          "description": "Taken right before the rung; absent for not_run rungs and older results.",
          "properties": {
            "at": {
              "type": "string"
            },
            "clients_total": {
              "type": "integer"
            },
            "clients_connected": {
              "type": "integer"
            },
            "connected": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exit_slots_total": {
              "type": [
                "integer",
                "null"
              ]
            },
            "exit_slots_in_use": {
              "type": [
                "integer",
                "null"
              ]
            },
            "exit_slots_free": {
              "type": [
                "integer",
                "null"
              ]
            },
            "probe_age_s": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "at",
            "clients_total",
            "clients_connected",
            "connected"
          ]
        }
      },
      "required": [
        "rung",
        "clients",
        "status",
        "failure_status",
        "total_mbps",
        "overlap_s",
        "start_skew_ms",
        "gap_before_s",
        "per_client"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "not": {
                  "const": "measured"
                }
              }
            }
          },
          "then": {
            "properties": {
              "total_mbps": {
                "type": "null"
              },
              "failure_status": {
                "$ref": "#/$defs/status"
              }
            }
          }
        }
      ]
    }
  }
}
